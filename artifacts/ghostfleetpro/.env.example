# ── Required ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (or self-hosted MongoDB URI)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ghostfleet?retryWrites=true&w=majority

# ── Proxy-Cheap (optional) ─────────────────────────────────────────────────────
# Proxy-Cheap session-pool mode. With one endpoint and account count 50, the
# app uses username-session-acc1 through username-session-acc50. This requires
# the provider's session-slot feature; it does not mean one endpoint has 50
# separate IPs unless the provider rotates/assigns one IP per session.
PROXY_CHEAP_HOST=your.proxy-cheap.host
PROXY_CHEAP_PORT=10000
PROXY_CHEAP_USERNAME=your_proxy_user
PROXY_CHEAP_PASSWORD=your_proxy_password
PROXY_CHEAP_ACCOUNT_COUNT=50

# Preferred mode for a fixed SOCKS IP pool supplied by PM2 ecosystem.cjs.
# One URL is leased to one connected account at a time. When an account is
# removed, token-rejected, or manually disconnected, its URL is returned to
# the free pool. Use commas or newlines between entries.
# SOCKS_PROXIES=socks5://user:pass@ip1:port,socks5://user:pass@ip2:port
# PROXY_POOL=socks5://user:pass@ip1:port,socks5://user:pass@ip2:port
# Proxy-Cheap's exported list format is also accepted. The entries may omit
# the http:// scheme, as in username:password@host:port, and are kept as
# dedicated sticky sessions in the order supplied.
# PROXY_URLS=username:password@proxy-cheap-host:8080,username:password@proxy-cheap-host:8080

# ── Required — Admin panel access ─────────────────────────────────────────────
# Set this to any secret string you choose. You'll type it into the admin page.
# Without this the admin/license panel returns a server error.
ADMIN_SECRET=change-this-to-something-secret

# ── Optional — AI Keyword feature ─────────────────────────────────────────────
# Your own OpenAI API key (get one at https://platform.openai.com/api-keys)
# If this is not set the AI keyword suggestion feature is simply disabled.
OPENAI_API_KEY=sk-...

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Performance — required for 50+ simultaneous WebSocket accounts ────────────
# Node.js uses only 4 DNS threads by default. Raise this or connections will
# queue up and time out when many accounts connect at once.
UV_THREADPOOL_SIZE=64
